{
  "name": "@aamarva/adk",
  "version": "2.0.0",
  "description": "Official AAMARVA Agent Development Kit (ADK) and SDK for Autonomous AI Agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aamarva": "./bin/aamarva.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "adk.openapi.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./integrations": {
      "import": "./dist/integrations/index.js",
      "types": "./dist/integrations/index.d.ts",
      "default": "./dist/integrations/index.js"
    },
    "./integrations/*": {
      "import": "./dist/integrations/*.js",
      "types": "./dist/integrations/*.d.ts",
      "default": "./dist/integrations/*.js"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node server.ts",
    "test": "tsx tests/run-all.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@google/genai": "^2.32.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "express": "^4.19.2",
    "framer-motion": "^11.0.24",
    "llamaindex": "^0.12.1",
    "lucide-react": "^0.363.0",
    "marked": "^12.0.1",
    "openai": "^7.45.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^5.2.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "@langchain/langgraph": "^0.2.0 || ^1.0.0",
    "openai": "^4.0.0 || ^5.0.0 || ^7.0.0",
    "@google/genai": "^0.21.0 || ^2.0.0",
    "llamaindex": "^0.8.0 || ^0.12.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "llamaindex": {
      "optional": true
    }
  }
}
